#!/usr/bin/env sh
set -e

if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

MVN_VERSION="3.9.11"
BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
CACHE_DIR="$BASE_DIR/.mvn/apache-maven-$MVN_VERSION"
ARCHIVE="$BASE_DIR/.mvn/apache-maven-$MVN_VERSION-bin.tar.gz"

if [ ! -x "$CACHE_DIR/bin/mvn" ]; then
  mkdir -p "$BASE_DIR/.mvn"
  echo "Maven n'est pas installé. Téléchargement de Maven $MVN_VERSION..."
  if command -v curl >/dev/null 2>&1; then
    curl -fL "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MVN_VERSION/apache-maven-$MVN_VERSION-bin.tar.gz" -o "$ARCHIVE"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ARCHIVE" "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MVN_VERSION/apache-maven-$MVN_VERSION-bin.tar.gz"
  else
    echo "Erreur : Maven absent et ni curl ni wget ne sont disponibles."
    exit 1
  fi
  tar -xzf "$ARCHIVE" -C "$BASE_DIR/.mvn"
fi

exec "$CACHE_DIR/bin/mvn" "$@"
